# 🎫 Bunly Railway Deployment Template
# Instructions: Copy these into the Railway Variables Dashboard for each service.

# ═══════════════════════════════════════════════════════════
# 🖥️  API SERVICE VARIABLES
# ═══════════════════════════════════════════════════════════

# 🚀 Infrastructure
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
PORT=4000

# 🔑 Authentication & Access
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL must point to the PUBLIC auth endpoint (through the frontend proxy)
BETTER_AUTH_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}/api/auth
# APP_URL is where email links point to (the frontend)
APP_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# CORS_ORIGIN allows browser requests from the frontend
CORS_ORIGIN=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

# WebSocket URL for video upload progress (native /ws/videos endpoint)
# buildWsUrl() in the API uses this for client WS connections
PUBLIC_WS_URL=wss://${{api.RAILWAY_PUBLIC_DOMAIN}}

# 🔐 OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 📦 S3 / Object Storage (Private Bucket)
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Set EITHER AWS_REGION or AWS_S3_REGION (Railway bucket uses the latter)
AWS_REGION=auto

# 📧 Email (Brevo) & Identity
BREVO_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
APP_NAME=Bunly

# ═══════════════════════════════════════════════════════════
# 🌐  FRONTEND SERVICE VARIABLES
# ═══════════════════════════════════════════════════════════

# Server-to-server: direct internal URL to the API (bypasses public proxy)
API_ORIGIN=https://${{api.RAILWAY_PUBLIC_DOMAIN}}

# Client-side: all browser requests go through the frontend (proxied via next.config.ts rewrites)
NEXT_PUBLIC_API_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_BETTER_AUTH_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}

# The frontend's own public URL (used for metadataBase, origin headers)
NEXT_PUBLIC_APP_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}


# OAuth provider toggles
NEXT_PUBLIC_GOOGLE_ENABLED=true
NEXT_PUBLIC_GITHUB_ENABLED=true


# ═══════════════════════════════════════════════════════════
# 👷  TRANSCODING WORKER VARIABLES
# ═══════════════════════════════════════════════════════════

# Core Infrastructure
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# S3 / Object Storage (Must match API settings exactly)
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=auto

# Performance & Tuning
TRANSCODER_CONCURRENCY=2
TEMP_DIR=/tmp/transcoder
HW_ACCEL=none


# ═══════════════════════════════════════════════════════════
# 🏊  WORKER POOL VARIABLES
# ═══════════════════════════════════════════════════════════

# Core Infrastructure
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Email Branding & Delivery (Brevo)
BREVO_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
APP_NAME=Bunly
