# 🎫 Bunly Railway Deployment Template
# Instructions: Copy these into the Railway Variables Dashboard for the API service.

# 🚀 Infrastructure
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
PORT=4000

# 🔑 Authentication & Access
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
APP_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGIN=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}},https://studio.bunly.app

# 📦 S3 / Object Storage (Private Bucket)
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-west-1

# 📧 Email (Brevo) & Identity
BREVO_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
APP_NAME=Bunly
