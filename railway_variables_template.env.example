# 🎫 Bunly Railway Deployment Template
# Copy these into the Railway Variables Dashboard for each service.

# 🚀 Infrastructure
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# 📦 S3 / Object Storage (Railway Bucket)
AWS_S3_ENDPOINT=https://storage.railway.app
# AWS_S3_REGION=us-west-1 (Change to your selected Railway Bucket region)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=

# 🔑 Authentication (Better Auth)
# Generate a core secret via: openssl rand -base64 32
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}

# 🌐 Networking
NODE_ENV=production
# CORS_ORIGIN=https://www.yourdomain.com
# PUBLIC_WS_URL=wss://api.yourdomain.com

# 🏗️ Build Arguments (CRITICAL for Frontend)
# Set these in the Variables tab for the frontend service specifically.
# NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
# NEXT_PUBLIC_S3_BUCKET_NAME=
# NEXT_PUBLIC_S3_REGION=
