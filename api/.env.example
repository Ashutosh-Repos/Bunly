# Server Environment Template
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Docker: postgresql://postgres:postgres@localhost:5432/bunly)
DATABASE_URL=""

# Authentication (Must match client)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Redis
REDIS_URL="redis://localhost:6379"
LOCAL_REDIS_URL="redis://localhost:6379"

# Object Storage (S3-compatible)
# Local Docker: http://localhost:9000 | Railway: https://t3.storageapi.dev
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="youtube-videos"
AWS_REGION="auto"
# Public URL for browser-facing presigned URLs
# Local: http://localhost:9000 | Railway: https://t3.storageapi.dev
PUBLIC_S3_URL="http://localhost:9000"

# WebSocket
PUBLIC_WS_URL="ws://localhost:4000"

# Upload & Job Settings
PRESIGNED_URL_EXPIRY=3600
UPLOAD_DB_EXPIRY=86400
DOWNLOAD_TIMEOUT_MS=7200000
JOB_LOCK_DURATION_MS=14400000
FILE_WAIT_TIMEOUT_MS=1800000
MAX_TEMP_AGE_MS=28800000
CLEANUP_INTERVAL_MS=900000
PROGRESS_THROTTLE_MS=5000

# Worker configuration
TRANSCODER_CONCURRENCY=2
TRANSCODER_RETRIES=3
ENABLE_WORKERS="true"
CLUSTER_MODE="false"
NODE_ID="dev-worker-1"
TEMP_DIR="/tmp/transcoder"
HW_ACCEL="none"

# Email (Brevo)
BREVO_API_KEY=""
APP_NAME="Bunly"
EMAIL_FROM=""

# --- OAuth (Better Auth) ---
# Add your Google/Github credentials here to enable social login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

